# ==============================================================================
# BizLink Universal Business Network — Environment Configuration
# ==============================================================================

# 1. SerpApi Engine (Google Local & Business Discovery)
# Obtain from: https://serpapi.com/manage-api-key
# If omitted, BizLink uses high-fidelity realistic directory mock mode.
SERPAPI_KEY=

# 2. Firebase Cloud Database Persistence (Optional Cloud Firestore Sync)
# Obtain from Firebase Console -> Project Settings -> General -> Your Apps -> Web App
# When configured, account data, offerings, relationships, and deals sync to Firestore.
# When omitted, BizLink runs seamlessly with the built-in Local Persistent Vault.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
